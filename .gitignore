# Fichiers à ignorer dans le dépôt Git

# macOS system files
.DS_Store
**/.DS_Store

# Fichiers temporaires Bash générés dans le projet
bash_*.txt

# Journaux et logs
*.log

# Dépendances Node.js (au cas où)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Artefacts de construction et de distribution
build/
dist/
*.swp
*.swo

# Répertoires et fichiers d'IDE
.vscode/
.idea/

# Fichiers de configuration sensibles (exemple)
.env
.env.local
.env.*.local

# Documentation et archives générées (copies du site)
doc/

doc/*.tar

doc/*.zip

# Metadata de l'agent / worktrees internes (ne jamais pousser)
.kilo/
